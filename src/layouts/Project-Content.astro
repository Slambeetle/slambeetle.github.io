---
---
<article class="project-content">
    <slot />
</article>

<style>
    :global(.section-grid) {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    @media (max-width: 100em) {
        :global(.section-grid) {
            display: block;
        }
    }

    :global(.section-grid img) {
        grid-column: 1 / -1;
        width: 100%;
    }

    .project-content :global(*) {
        line-height: 1.25;
    }

    .project-content :global(blockquote) {
        font-size: var(--text-xl);
    }

    .project-content :global(h5) {
        margin-top: 4rem;
    }
    .project-content :global(h5) {
        margin-top: 4rem;
        line-height: 2;
    }

    .project-content :global(img) {
        display: block;
        margin: 1rem 0 1rem 0;
    }

    .project-content :global(hr) {
        margin: 4rem 0 0 0;
        height: 1px;
        color: var(--gray-300);
        background: var(--gray-300);
        font-size: 0;
        border: 0;
    }
</style>