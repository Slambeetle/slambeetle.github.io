---
interface Props {
    headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
---

<div class="layout">
    <aside class="toc">
        <nav>
            <p>On this page</p>
            {headings.map(h => (
                    <a href={`#${h.slug}`} class={`depth-${h.depth}`}>
                        {h.text}
                    </a>
            ))}
        </nav>
    </aside>

    <article>
        <slot />
    </article>
</div>

<style>
    .layout {
    }

    .toc {
        position: sticky;
        top: 1rem;
        height: fit-content;
    }
</style>