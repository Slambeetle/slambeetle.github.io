---
interface Props {
    src: string;
    alt?: string;
    height?: string;
}

const { src, alt = "360 photo", height = "600px" } = Astro.props;
const uniqueId = Math.random().toString(36).substring(7);
---

<link rel="stylesheet" href="https://cdn.pannellum.org/2.5/pannellum.css">

<div id={`panorama-${uniqueId}`}></div>

<style>
    div[id^="panorama-"] {
        width: 100%;
        height: 600px;
        border-radius: 30px;
    }
</style>

<script define:vars={{ src, uniqueId }}>
    const script = document.createElement("script");
    script.src = "https://cdn.pannellum.org/2.5/pannellum.js";
    script.onload = () => {
        window.pannellum.viewer(`panorama-${uniqueId}`, {
            type: "equirectangular",
            panorama: src,
            autoLoad: true,
            autoRotate: -2,
            showControls: false
        });
    };
    document.head.appendChild(script);
</script>