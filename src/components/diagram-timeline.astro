---

---
<input class="slider" type="range" id="slider" min="0" step="1" value="0" />

<div class="diagram-stage">
    <slot />
</div>
<script>
    const MOBILE_BREAKPOINT = 992;

    function initializeSlider() {
        const slider = document.getElementById('slider') as HTMLInputElement | null;
        const layers = document.querySelectorAll<HTMLElement>('.diagram-layer');

        if (!slider) return;

        function updateLayers(step: number) {
            layers.forEach((layer, i) => {
                const diagram = layer.querySelector<HTMLElement>('.diagram');
                const caption = layer.querySelector<HTMLElement>('.caption');

                if (diagram) diagram.style.opacity = i <= step ? '1' : '0';
                if (caption) caption.style.opacity = i === step ? '1' : '0';
            });
        }

        if (window.innerWidth > MOBILE_BREAKPOINT) {
            slider.style.display = 'block';
            slider.max = String(layers.length - 1);

            updateLayers(Number(slider.value));
            slider.addEventListener('input', (e) => {
                updateLayers(Number(slider.value));
            });
        } else {
            updateLayers(layers.length);
            slider.style.display = 'none';
        }
    }

    initializeSlider();
    window.addEventListener('resize', initializeSlider);
</script>
<style>
    .diagram-stage {
        position: relative;
        width: 100%;
        margin: 0 auto;
        aspect-ratio: 3 / 2;
    }

    .diagram-stage :global(.layer:first-child) {
        opacity: 1;
    }

    .slider {
        margin: 30px 0;
        width: 100%;
        height: 3px;
        background: var(--gray-500);
        outline: none;
        cursor: pointer;
    }

    .slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--gray-500);
        opacity: 1;
        cursor: pointer;
        z-index: 3;
    }

    .slider::-moz-range-thumb {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--gray-500);
        opacity: 1;
        cursor: pointer;
        z-index: 3;
    }

    @media (max-width: 992px) {
        .slider {
            display: none;
            appearance: none;
        }

        .diagram-stage {
            aspect-ratio: auto; /* Don't force the 3/2 ratio */
            min-height: auto;
        }
    }
</style>