---
import type { CollectionEntry } from "astro:content";

interface Props {
    project: CollectionEntry<'projects'>;
}
const { data, id } = Astro.props.project;

const VIDEO_EXTENSIONS = ['.mp4', '.MP4', '.webm', '.mov', '.avi', '.mkv'];
const isVideo = VIDEO_EXTENSIONS.some(ext => data.cover.endsWith(ext));

---

<a class="card" id="card-width" href={`/projects/${id}`}>
    <div class="card-description">
        <h5>{data.title}</h5>
        <p>{data.type}</p>
    </div>
    <div class="overlay">
        {isVideo
            ? <video autoplay muted loop playsinline>
                    <source src={data.cover} type="video/mp4" />
                </video>
            : <img src={data.cover} alt={data.cover_alt} loading="lazy" decoding="async" />
        }
    </div>
</a>

<style>
    .card {
        display: block;
        position: relative;
        height: clamp(120px, 20vw, 30vw);
        min-width: 0;
        overflow: hidden;
        object-fit: cover;
        box-shadow: inset 0 8px 6px -6px black;
    }

    .overlay::before {
        content: '';
        z-index: 1;
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        object-fit: cover;
        background: linear-gradient(0deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 50%);
    }

    #card-width {
        width: 25%;
    }

    @media (max-width: 150em) {
        #card-width {
            width: 25%;
        }
    }

    @media (max-width: 100em) {
        #card-width {
            width: 30%;
        }
    }
    
    @media (max-width: 50em) {
        #card-width {
            width: 50%;
        }
    }

    .card img, video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-description {
        position: absolute;
        bottom: 0;
        left: 0;
        z-index: 2;
        padding: 1rem 1rem;
    }
    .card-description h5 {
        color: white;
        margin-bottom: .25em;
        line-height: 1.3;
    }
    .card-description p{
        font-size: 0.8rem;
        color: white;
    }
</style>