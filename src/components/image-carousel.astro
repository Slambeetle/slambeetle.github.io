---
const id = `splide-${Math.random().toString(36).slice(2, 9)}`;
---
<link href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>

<section id={id} class="splide" aria-label="Image carousel">
    <div class="splide__track">
        <ul class="splide__list">
            <slot />
        </ul>
    </div>
</section>

<script>
    import Splide from '@splidejs/splide';
    import { Video } from '@splidejs/splide-extension-video';
    import '@splidejs/splide-extension-video/dist/css/splide-extension-video.min.css';
    import '@splidejs/splide/dist/css/splide-core.min.css';
    import '@splidejs/splide/dist/css/splide.min.css';

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.splide:not(.is-initialized)').forEach(el => {
            new Splide(el, {
                type: 'loop',
                autoWidth: true,
                gap: '1rem',
                focus: 'center',
                pagination: false,
                video: {
                    mute: true,
                    loop: true,
                    autoplay: true,
                    hideControls: true
                },
            }).mount({ Video });
        });
    });
</script>

<style>
    .splide {
        max-width: 2000px;
        margin: 0 auto;
    }

    :global(.splide__slide img) {
        height: 520px;
        width: auto;
        border-radius: 30px;
        display: block;
    }

    :global(.splide__video__wrapper){
        border-radius: 30px;
    }

    :global(.splide__arrow) {
        background: white;
        opacity: 1;
        border: 2px solid #333;
        width: 48px;
        height: 48px;
        z-index: 9999;
    }

    :global(.splide__arrow svg) {
        fill: #333;
    }

    :global(.splide__arrow:hover) {
        background: #333;
    }

    :global(.splide__arrow:hover svg) {
        fill: white;
    }
</style>