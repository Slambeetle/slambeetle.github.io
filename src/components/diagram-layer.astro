---
interface Props {
    src: string;
    heading?: string;
}

const { src, heading="" } = Astro.props;
---

<div class="diagram-layer">
    <div class="caption">
        <h5>{heading}</h5>
        <slot />
    </div>
    <img class="diagram" src={src}/>
</div>

<style>
    .diagram-layer {
        position: absolute;
        width: 100%;
        inset: 0;
        opacity: 1;
        transition: opacity 0.5s ease;
    }

    .diagram {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .caption {
        position: absolute;
        width: 50%;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    /* Mobile: show one layer at a time */
    @media (max-width: 992px) {
        .diagram-layer {
            position: relative;
            inset: auto;
            height: auto;
            display: flex;
            flex-direction: column;
            margin-bottom: var(--gap);
            opacity: 1 !important; /* Always visible */
        }

        .caption {
            position: static;
            width: 100%;
            opacity: 1 !important;
            margin-bottom: var(--gap-half);
        }

        .diagram {
            height: auto;
            aspect-ratio: 3 / 2;
        }
    }
</style>