---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ProjectSplitLayout from "../../layouts/ProjectSplitLayout.astro";
import ProjectFullLayout from "../../layouts/ProjectFullLayout.astro";


interface Props {
    entry: CollectionEntry<'projects'>
}

export async function getStaticPaths() {
    const work = await getCollection('projects');
    return work.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings} = await render(entry);

---

<ProjectFullLayout entry={entry} headings={headings} >
    <Content />
</ProjectFullLayout>