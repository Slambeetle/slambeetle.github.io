---
import Base from '../layouts/Base.astro';

const links = [
    { label: "GitHub", url: "https://github.com/Slambeetle" },
    { label: "Email", url: "mailto:you@email.com" },
    { label: "LinkedIn", url: "https://linkedin.com/in/yourprofile" },
];
---

<Base title="Contact">
    <section class="contact">
        <h1>Get in touch</h1>
        <p>I'm always open to new opportunities and collaborations. Reach out via any of the links below.</p>

        <ul class="links">
            {links.map(link => (
                    <li>
                        <a href={link.url} target="_blank" rel="noopener">
                            {link.label} ↗
                        </a>
                    </li>
            ))}
        </ul>
    </section>
</Base>

<style>
    .contact {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        max-width: 600px;
    }

    h1 {
        font-size: 2.5rem;
    }

    p {
        color: #555;
        font-size: 1.1rem;
    }

    .links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0rem;
    }

    .links a {
        display: inline-block;
        font-size: 1.5rem;
        font-weight: 300;
        padding: 1rem 0;
        border-bottom: 1px solid #eee;
        width: 100%;
        transition: padding-left 0.2s;
    }

    .links a:hover {
        padding-left: 0.5rem;
        text-decoration: none;
    }
</style>