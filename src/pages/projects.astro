---
import Base from '../layouts/Base.astro';
import projects from '../data/projects.json';
---

<Base title="Projects">
    <section class="projects">
        <h1>Projects</h1>
        <div class="grid">
            {projects.map(project => (
                    <a href={project.url} class="card" target="_blank" rel="noopener">
                        <div class="card-content">
                            <h2>{project.title}</h2>
                            <p>{project.description}</p>
                            <ul class="tags">
                                {project.tags.map(tag => (
                                        <li>{tag}</li>
                                ))}
                            </ul>
                        </div>
                        <span class="arrow">↗</span>
                    </a>
            ))}
        </div>
    </section>
</Base>

<style>
    .projects {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    h1 {
        font-size: 2.5rem;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .card {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 1.5rem;
        border: 1px solid #eee;
        border-radius: 8px;
        transition: border-color 0.2s;
    }

    .card:hover {
        border-color: #111;
        text-decoration: none;
    }

    .card-content {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    h2 {
        font-size: 1.1rem;
        font-weight: 600;
    }

    p {
        font-size: 0.95rem;
        color: #555;
        line-height: 1.5;
    }

    .tags {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .tags li {
        font-size: 0.8rem;
        padding: 0.2rem 0.6rem;
        background: #f5f5f5;
        border-radius: 999px;
        color: #555;
    }

    .arrow {
        font-size: 1.2rem;
        color: #aaa;
        flex-shrink: 0;
    }
</style>