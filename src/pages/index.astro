---
import Base from '../layouts/Base.astro';
---

<Base title="Home">

</Base>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding: 4rem 0;
	}

	h1 {
		font-size: 3rem;
		line-height: 1.2;
	}

	p {
		font-size: 1.2rem;
		color: #555;
		max-width: 500px;
	}

	.links {
		display: flex;
		gap: 1.5rem;
		margin-top: 1rem;
	}

	.links a {
		padding: 0.6rem 1.2rem;
		border: 1px solid #111;
		border-radius: 4px;
		font-size: 0.95rem;
	}

	.links a:hover {
		background: #111;
		color: #fff;
		text-decoration: none;
	}
</style>